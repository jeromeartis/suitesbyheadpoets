# Copy this file to ".env" and fill in your real values. Never commit ".env" itself.

# --- Twilio (https://www.twilio.com/console) ---
# Account SID and Auth Token from your Twilio Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# A phone number you bought/rented in Twilio, in E.164 format
TWILIO_PHONE_NUMBER=+15551234567

# --- Admin / Management page login ---
# Whatever password the front-desk/manager will type in to reach the Management page
ADMIN_PASSWORD=change_this_password
# Random long string used to sign the login session cookie
SESSION_SECRET=change_this_to_a_long_random_string

# --- Server ---
PORT=3000
# Your site's public URL, no trailing slash. Used to build the "cancel or change your
# appointment" link sent in SMS reminders (e.g. https://suitesbyheadpoets.up.railway.app
# once deployed, or http://localhost:3000 for local testing), and as the allowed
# cross-origin origin for the API. Set this to your real deployed URL in production.
BASE_URL=http://localhost:3000
# Hour (0-23, server local time) the daily appointment-reminder job runs. Reminders go
# out for any appointment happening the next calendar day.
REMINDER_HOUR=9

# Shop info shown on the site and used in SMS signatures
SHOP_NAME="SuitesByHeadPoets"
